# Contrato de configuracion de una instancia de UrraHosting-Cloud.
# Todas las variables marcadas [system] son inyectadas automaticamente por
# el Dashboard (docker-host) via el ServiceTemplate 'cloudstorage'
# (ver scripts/seed_service_template.py) cuando se despliega como
# platform_stack. Las marcadas [user] las captura el wizard de despliegue.
# Ver config/platform_config.py: este es el UNICO lugar donde se documenta
# el contrato; ese modulo es el unico que lee os.environ directamente.

# --- Identidad / filesystem [system] ---
INSTANCE_ID=dev-local
DATA_DIR=./data
DATA_DIR_HOST_ABS=

# --- Red / puertos [system] ---
APP_PORT=5000
WEBDAV_PORT=5001
TRAEFIK_PUBLIC_NETWORK=traefik-public
TRAEFIK_WEB_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
PUBLIC_BASE_DOMAIN=
TRUSTED_PROXY_COUNT=1

# --- Auth inicial del owner [user] ---
APP_USER=owner@example.com
APP_PASSWORD=cambia-esta-contraseña-unica

# --- Secretos [system, generados] ---
APP_SECRET=cambia-este-secreto-largo-y-aleatorio-64-hex
ORCHESTRATOR_TOKEN=cambia-este-token-largo-y-aleatorio-64-hex

# --- Base de datos [system, generado] ---
DATABASE_URL=postgresql+psycopg2://cloud:cloud@db:5432/cloud
DB_PASSWORD=cambia-esta-password-db

# --- Redis (cache / rate-limit / cola RQ) ---
REDIS_URL=redis://redis:6379/0

# --- Politica de la instancia (editable luego desde Admin Panel) ---
SESSION_COOKIE_SECURE=true
DEBUG=false
MAX_UPLOAD_MB=5120
INSTANCE_STORAGE_GB=50
DEFAULT_USER_QUOTA_GB=5
TRASH_RETENTION_DAYS=30
VERSION_RETENTION_COUNT=10

# --- Recursos del contenedor app [system] ---
APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=768M
WORKER_CPU_LIMIT=0.5
WORKER_MEMORY_LIMIT=512M

# --- Backend de almacenamiento (Fase 3, opcional) ---
# 'local' (default) usa el volumen DATA_DIR. 's3' apunta a cualquier
# endpoint S3-compatible (AWS S3, MinIO, etc.) - solo necesario para
# instancias que necesiten escalar app/webdav horizontalmente sin
# filesystem compartido. Ver app/services/storage/s3_backend.py.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Antivirus opcional (Fase 3) ---
# Si se deja vacio, el escaneo de archivos subidos se omite por completo
# (no falla, simplemente no hay ClamAV disponible). Requiere un daemon
# clamd accesible desde el contenedor 'worker' - no se incluye en
# compose.yml por defecto (infraestructura que el operador provisiona
# aparte). Ver app/worker/antivirus.py.
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Edicion colaborativa opcional (Fase 4) ---
# Si se deja vacio, la accion "Editar" para documentos ofimaticos queda
# oculta. Requiere un OnlyOffice Document Server accesible (no se incluye
# en compose.yml). ONLYOFFICE_JWT_SECRET es opcional pero muy recomendado
# (viene activado por defecto en instalaciones nuevas de Document Server).
# Ver app/blueprints/drive/onlyoffice.py.
ONLYOFFICE_SERVER_URL=
ONLYOFFICE_JWT_SECRET=
